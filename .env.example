# Copie este arquivo para .env e preencha com suas credenciais
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=seu_segredo_aqui_minimo_32_chars

# Senha usada no PRIMEIRO login. Após o primeiro login, o hash fica gravado no banco.
# Mude depois pelo painel de configurações.
ADMIN_INITIAL_PASSWORD=troque_esta_senha
